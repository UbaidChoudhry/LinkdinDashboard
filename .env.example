# Salary enrichment API keys — copy to .env and fill in. .env is gitignored.
# See SALARY_SETUP.md for how to obtain each key. All are optional:
# without them, the LCA local dataset still works and jobs simply fall back
# to "no salary" (sorted to the bottom).

# Adzuna — https://developer.adzuna.com/  (free tier ~1,000 calls/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# h1bapi.com — https://h1bapi.com/  (company-specific H-1B wage data)
# LEAVE BLANK to use the free tier: 20 requests/day, last 2 fiscal years, NO key needed.
# Only set this if you buy a paid plan — and then raise salary.daily-cap.h1bapi to match.
H1BAPI_KEY=

# NOTE: there is deliberately no LCA import setting here. The import is triggered by
# ./import-lca.sh (which defaults to the data/lca directory) and nothing else -- putting it
# in .env would make ./run.sh import-and-exit instead of starting the server.
